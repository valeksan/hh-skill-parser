LOGLEVEL=info

# DB-backed package CLI. Empty means public HH API without Authorization.
# HH_ACCESS_TOKEN=
# HH_USER_AGENT=hh-skill-parser/1.0 (contact@example.invalid)
# HH_DATABASE=hh_mobilization.sqlite3

# Network tuning for HH requests
HH_BROWSER_USER_AGENT=Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0.0.0 Safari/537.36
HTTPS_PROXY=
HTTP_PROXY=

# Request pacing
# HH_ENV_FILE can point to another env file if needed.
HH_ENV_FILE=.env
